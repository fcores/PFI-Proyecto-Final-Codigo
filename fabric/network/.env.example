# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Variables de la red Fabric de MedChain.
#
# Copiar a .env (gitignored) antes de levantar la red:
#   cp .env.example .env
#
# Lo consumen: fabric/network.sh, fabric/scripts/install-fabric.sh y
# fabric/network/compose/compose-net.yaml.
# ─────────────────────────────────────────────────────────────────────────────

# Versiones de Fabric (usadas por install-fabric.sh y por las imágenes del compose)
IMAGE_TAG=2.5.15
CA_IMAGE_TAG=1.5.13

# Imágenes Docker
FABRIC_ORDERER_IMAGE=hyperledger/fabric-orderer
FABRIC_PEER_IMAGE=hyperledger/fabric-peer
FABRIC_TOOLS_IMAGE=hyperledger/fabric-tools
COUCHDB_IMAGE=couchdb:3.3.3

# Red Docker compartida por todos los contenedores (peers, couchdb, gateway)
DOCKER_NETWORK=pfi

# Nivel de log de peers/orderer
FABRIC_LOGGING_SPEC=INFO

# Credenciales del state DB CouchDB (una instancia por peer)
COUCHDB_USER=admin
COUCHDB_PASSWORD=adminpw

# Token compartido entre el backend y fabric-gateway-svc (header X-Gateway-Token).
# Generar uno propio, p. ej.: openssl rand -hex 32
GATEWAY_AUTH_TOKEN=cambiame-por-un-token-largo

# El gateway sirve solo HTTPS (8443) con el certificado de
# fabric/scripts/gateway-tls.sh. Para desarrollo local se puede habilitar ademas
# HTTP plano (y publicar el puerto en compose-net.yaml). Nunca en la EC2.
# GATEWAY_LISTEN_ADDR=:8081
