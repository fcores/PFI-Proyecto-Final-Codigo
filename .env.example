# ──────────────────────────────────────────────────────────────
# MedChain AI — Variables de entorno
# Copiar como .env y ajustar los valores.
# NUNCA commitear .env al repositorio.
# ──────────────────────────────────────────────────────────────

# ─── Entorno ──────────────────────────────────────────────────
# Valores: local | staging | production
# En production sin DATABASE_URL el backend falla al arrancar (fail-fast).
ENVIRONMENT=local

# ─── Base de datos ────────────────────────────────────────────
# PostgreSQL en AWS RDS. Sin esta variable en modo local se usa in-memory.
# DATABASE_URL=postgresql://user:password@host:5432/medchain?sslmode=verify-full

# ─── Autenticacion ────────────────────────────────────────────
AUTH_USERNAME=admin
AUTH_PASSWORD=cambiar-esta-clave
AUTH_DISPLAY_NAME=Administrador

# ─── CORS ─────────────────────────────────────────────────────
# Origenes permitidos separados por coma.
# En produccion: dominio de CloudFront.
# CORS_ORIGINS=https://d3qe3o25c33oqd.cloudfront.net

# ─── Modelo ML ────────────────────────────────────────────────
# Ruta al artefacto LightGBM. Por defecto: ml_models/artefactos/modelo_gbm.joblib
# ML_MODEL_PATH=ml_models/artefactos/modelo_gbm.joblib

# ─── Cifrado de PHI (Fase 2) ─────────────────────────────────
# En produccion la clave se obtiene de AWS Secrets Manager.
# En local/test se puede usar esta variable (solo para desarrollo).
# Generar con: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# ENCRYPTION_KEY_DEV=<base64-encoded-32-bytes>

# ─── AWS Secrets Manager (Fase 2+) ───────────────────────────
# ARN del secreto que contiene la clave maestra de cifrado.
# ENCRYPTION_SECRET_ARN=arn:aws:secretsmanager:us-east-1:007072540405:secret:medchain/encryption-key-XXXXXX

# ─── Fabric Gateway (Fase 3) ─────────────────────────────────
# URL del sidecar fabric-gateway-svc corriendo en la EC2 de Fabric.
# FABRIC_GATEWAY_URL=http://10.0.x.x:8081

# ─── Logging ──────────────────────────────────────────────────
# Nivel: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
