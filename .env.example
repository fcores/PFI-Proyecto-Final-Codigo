# Credenciales de acceso a la aplicación (login).
# Copiá este archivo como .env y ajustá los valores.
AUTH_USERNAME=admin
AUTH_PASSWORD=cambiar-esta-clave
AUTH_DISPLAY_NAME=Administrador

# CORS: origenes permitidos separados por coma.
# En produccion poner el dominio de CloudFront.
# Si no se define, se permite cualquier origen.
# CORS_ORIGINS=https://d1234abcd.cloudfront.net
