# Hyperledger Fabric
# ──────────────────────────────────────────────────────────────

# Binarios de Fabric descargados (peer, orderer, configtxgen, cryptogen...)
fabric/bin/
# Config base descargada (core.yaml, orderer.yaml, configtx.yaml de muestra)
fabric/config/
# Imágenes/artefactos generados en runtime
fabric/network/organizations/
fabric/network/channel-artifacts/
fabric/network/system-genesis-block/
*.block
*.tx

# Material criptográfico (NUNCA versionar claves privadas)
**/msp/keystore/
**/*_sk
**/priv_sk
# CA y certificado TLS del puente (fabric/scripts/gateway-tls.sh)
fabric/network/gateway-tls/

# Chaincode empaquetado
*.tar.gz

# Go
chaincode/**/vendor/

# Logs y temporales
fabric/network/log.txt

# Deploy state (IDs de recursos AWS generados por los scripts)
deploy/.env.deploy

# Snapshots de estado AWS para rollback (contienen IDs de la cuenta)
deploy/rollback/
